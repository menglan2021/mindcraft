TZ=Asia/Shanghai

# Minecraft 对外端口
MC_PUBLIC_PORT=25565
VOICECHAT_PUBLIC_PORT=24454

# Mindcraft Web UI 只建议绑定到本机，再通过 SSH 隧道访问
MINDSERVER_BIND=127.0.0.1
MINDSERVER_PUBLIC_PORT=8080

# Paper 容器参数
MC_MEMORY=6G
ONLINE_MODE=FALSE
MODE=survival
DIFFICULTY=normal
MAX_PLAYERS=10
MOTD=Mindcraft Voice Server
SERVER_NAME=Mindcraft Voice Server
OPS=你的游戏管理员ID
RCON_PASSWORD=请改成强密码

# 语音输入参数
VOICE_INPUT_ENABLED=true
VOICE_INPUT_ECHO_TO_CHAT=true
VOICE_INPUT_STT_MODEL=qwen/qwen3-asr-flash
VOICE_INPUT_LANGUAGE=zh
VOICE_INPUT_END_SILENCE_MS=900
VOICE_INPUT_MIN_DURATION_MS=700
VOICE_INPUT_MAX_DURATION_MS=15000