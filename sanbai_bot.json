{
    "name": "sanbai_bot",

    "model": {
        "api": "qwen",
        "model": "qwen3.6-flash",
        "url": "https://api.sanbai.cloud/v1",
        "key_name": "QWEN_CHAT_API_KEY"
    },

    "code_model": {
        "api": "qwen",
        "model": "qwen3.6-flash",
        "url": "https://api.sanbai.cloud/v1",
        "key_name": "QWEN_CHAT_API_KEY"
    },

    "vision_model": {
        "api": "qwen",
        "model": "qwen3.6-flash",
        "url": "https://api.sanbai.cloud/v1",
        "key_name": "QWEN_CHAT_API_KEY"
    },

    "embedding": {
        "api": "qwen",
        "model": "text-embedding-v4",
        "url": "https://dashscope.aliyuncs.com/compatible-mode/v1"
    },

    "speak_model": {
        "api": "qwen",
        "model": "qwen3-tts-instruct-flash-realtime",
        "url": "https://dashscope.aliyuncs.com/compatible-mode/v1",
        "voice": "Cherry",
        "params": {
            "language_type": "Chinese",
            "instructions": "用自然、清晰、偏口语的中文语气说话，语速稍快一些。",
            "optimize_instructions": true,
            "first_audio_timeout_ms": 30000
        }
    },

    "voice_bridge": {
        "enabled": true,
        "bot_entity_name": "sanbai_bot",
        "sample_rate": 48000,
        "channels": 1
    }

}